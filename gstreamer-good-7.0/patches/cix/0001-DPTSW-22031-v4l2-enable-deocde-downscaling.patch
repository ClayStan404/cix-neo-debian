+GstCaps *
+gst_v4l2_object_verify_resolution (GstV4l2Object * v4l2object,
+    GstCaps * caps, struct v4l2_rect * rect,
+    const GValue * fmt, gboolean is_drm, GstCaps * out_caps)
+{
+  GstV4l2Error error;
+  const GstV4L2FormatDesc *desc, *fallback_desc = NULL;
+  GstStructure *s = gst_caps_get_structure (caps, 0);
+  const gchar *str = g_value_get_string (fmt);
+  GstVideoFormat format = gst_video_format_from_string (str);
+  struct v4l2_rect r = *rect;
+
+  if (G_VALUE_TYPE (fmt) != G_TYPE_STRING)
+    return out_caps;
+
+  if (is_drm) {
+    guint64 drm_modifier;
+    guint32 drm_fourcc =
+        gst_video_dma_drm_fourcc_from_string (str, &drm_modifier);
+    desc = gst_v4l2_object_get_desc_from_drm_fourcc (drm_fourcc, drm_modifier,
+        NULL);
+    gst_structure_set (s, "drm-format", G_TYPE_STRING, str, NULL);
+  } else {
+    desc =
+        gst_v4l2_object_get_desc_from_video_format (format, &fallback_desc);
+    gst_structure_set (s, "format", G_TYPE_STRING, str, NULL);
+  }
+  /* Set format first */
+  gst_v4l2_object_update_format (v4l2object, desc, &error);
+
+  /* Then set compose to get downscaled resolution of specified format */
+  if (!gst_v4l2_object_set_compose (v4l2object, &r))
+    return out_caps;
+
+  /* Now update width and height in caps with driver returned compose region */
+  GValue v = G_VALUE_INIT;
+  g_value_init (&v, G_TYPE_INT);
+  g_value_set_int (&v, r.width);
+  gst_structure_set_value (s, "width", &v);
+  g_value_set_int (&v, r.height);
+  gst_structure_set_value (s, "height", &v);
+
+  GST_DEBUG_OBJECT (v4l2object->dbg_obj, "verified caps %" GST_PTR_FORMAT, caps);
+  out_caps = gst_caps_merge (out_caps, caps);
+
+  return out_caps;
+}
+

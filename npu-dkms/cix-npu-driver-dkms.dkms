PACKAGE_NAME="aipu"
PACKAGE_VERSION="#MODULE_VERSION#"

MAKE[0]="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build BUILD_AIPU_VERSION_KMD=BUILD_ZHOUYI_V3 BUILD_TARGET_PLATFORM_KMD=BUILD_PLATFORM_SKY1 BUILD_NPU_DEVFREQ=y COMPASS_DRV_BTENVAR_KMD_VERSION=${PACKAGE_VERSION}"
CLEAN="make clean"

BUILT_MODULE_NAME[0]="aipu"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates"

BUILD_EXCLUSIVE_ARCH="aarch64"
BUILD_EXCLUSIVE_CONFIG="CONFIG_ARCH_CIX"

AUTOINSTALL="yes"

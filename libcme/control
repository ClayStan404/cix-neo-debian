Package: cix-libcme
Architecture: arm64
Multi-Arch: same
Depends:
 ${misc:Depends},
 ${shlibs:Depends},
Description: CIX Media Engine runtime library
 The CIX Media Engine provides hardware-accelerated image processing with
 CPU, DRM/DPU, and OpenCL execution paths.
 .
 This package contains the runtime library and OpenCL kernels.

Package: cix-libcme-dev

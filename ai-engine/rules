#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

include /usr/share/dpkg/buildflags.mk

%:
	dh $@ --with python3

override_dh_auto_build:
	$(MAKE) -C noe_engine_cpp -f makefile \
		CXX=g++ \
		LIB_CXXFLAGS="-I. -I/usr/share/cix/include/npu -std=c++17 -Wall -Wextra -fPIC $(CPPFLAGS) $(CXXFLAGS)" \
		BENCHMARK_CXXFLAGS="-I. -I/usr/share/cix/include/npu -std=c++17 -Wall -Wextra $(CPPFLAGS) $(CXXFLAGS)" \
		LIB_LDFLAGS="-L/usr/share/cix/lib -lnoe -shared -Wl,-soname,libnoe_engine.so $(LDFLAGS) -Wl,-rpath,/usr/share/cix/lib,--enable-new-dtags" \
		BENCHMARK_LDFLAGS="-L. -lnoe_engine -L/usr/share/cix/lib -lnoe $(LDFLAGS) -Wl,-rpath,/usr/share/cix/lib,--enable-new-dtags"
	mkdir -p debian/wheels
	for project in noe_engine mnn_engine cix_engine; do \
		python3 -m build --wheel --no-isolation \
			--outdir "$(CURDIR)/debian/wheels" "$$project"; \
	done

override_dh_auto_clean:
	$(MAKE) -C noe_engine_cpp -f makefile clean
	rm -rf debian/wheels */build */dist */*.egg-info

override_dh_install:
	dh_install
	for wheel in debian/wheels/*.whl; do \
		python3 -m installer --destdir=debian/cix-ai-engine --prefix=/usr "$$wheel"; \
	done

override_dh_shlibdeps:
	dh_shlibdeps -l/usr/share/cix/lib
